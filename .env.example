# --- API (services/api) ---
# demo: labelled fixtures from ./fixtures, no ROS needed | live: poll the ROS adapter
STUDIO_MODE=demo
STUDIO_FIXTURE=healthy
ADAPTER_URL=http://127.0.0.1:8765
# Subsystems the overall status requires (upper_body, navigation)
STUDIO_SUBSYSTEMS=upper_body,navigation
# SQLite by default; Postgres: postgresql+psycopg://user:pass@host/db (pip install -e "services/api[postgres]")
DATABASE_URL=sqlite:///./data/studio.db
POLL_INTERVAL_S=0.5
EVAL_INTERVAL_S=1.0
RECORD_HEARTBEAT_S=60
TELEMETRY_BUFFER=600
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Optional LLM phrasing (the deterministic answer is always returned) ---
# none | ollama | strands   (strands: pip install -e "services/agent[strands]")
LLM_PROVIDER=none
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- ROS adapter (services/ros-adapter, runs in the ROS 2 Jazzy environment) ---
ADAPTER_HOST=127.0.0.1
ADAPTER_PORT=8765
ROBOT_STACK_REVISION=
ROS_DOMAIN_ID=0
